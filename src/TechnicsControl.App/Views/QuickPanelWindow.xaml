<Window
    x:Class="TechnicsControl.App.Views.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="Technics Control">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Padding="20,16,20,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock x:Name="DeviceNameText" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <TextBlock x:Name="BatteryText" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <BitmapIcon x:Name="CodecIcon" ShowAsMonochrome="True" Height="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsClosable="False">
            <InfoBar.ActionButton>
                <Button x:Name="RetryButton" Content="再接続" Click="OnRetryClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <toolkit:Segmented x:Name="ModeSelector" Grid.Row="2" HorizontalAlignment="Stretch" SelectionChanged="OnModeSelectionChanged">
            <toolkit:SegmentedItem Tag="NoiseCanceling" Content="NC" ToolTipService.ToolTip="ノイズキャンセリング">
                <toolkit:SegmentedItem.Icon>
                    <BitmapIcon UriSource="ms-appx:///Assets/Official/Icons/Dark/ic_noise_cancellation_regular_96px.png" ShowAsMonochrome="True" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
            <toolkit:SegmentedItem Tag="Transparent" Content="トランスペアレント" ToolTipService.ToolTip="外音取り込み（トランスペアレント）">
                <toolkit:SegmentedItem.Icon>
                    <BitmapIcon UriSource="ms-appx:///Assets/Official/Icons/Dark/ic_ambiet_sound_regular_96px.png" ShowAsMonochrome="True" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
            <toolkit:SegmentedItem Tag="Attention" Content="アテンション" ToolTipService.ToolTip="外音取り込み（アテンション）">
                <toolkit:SegmentedItem.Icon>
                    <BitmapIcon UriSource="ms-appx:///Assets/Official/Icons/Dark/ic_ambiet_sound_regular_96px.png" ShowAsMonochrome="True" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
            <toolkit:SegmentedItem Tag="Off" Content="OFF" ToolTipService.ToolTip="OFF">
                <toolkit:SegmentedItem.Icon>
                    <BitmapIcon UriSource="ms-appx:///Assets/Official/Icons/Dark/ic_normal_regular_96px.png" ShowAsMonochrome="True" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
        </toolkit:Segmented>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LevelCaption" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
            <Slider x:Name="LevelSlider" Grid.Column="1" Minimum="1" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10"
                    ValueChanged="OnLevelChanged" />
            <TextBlock x:Name="LevelText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <FontIcon x:Name="SyncIcon" FontSize="14" />
            <TextBlock x:Name="SyncText" Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>

        <HyperlinkButton Grid.Row="5" Content="Technics Control を開く" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="OnOpenClick" />
    </Grid>
</Window>
