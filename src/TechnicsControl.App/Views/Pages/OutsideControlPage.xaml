<Page
    x:Class="TechnicsControl.App.Views.Pages.OutsideControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TechnicsControl.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer x:Name="Scroller">
        <StackPanel x:Name="RootPanel" MaxWidth="760" Padding="36,8,36,36" Spacing="24">
            <TextBlock Text="外音コントロール" Style="{ThemeResource TitleTextBlockStyle}" />

            <InfoBar x:Name="StatusBar" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Name="RetryButton" Content="再接続" Click="OnRetryClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <toolkit:Segmented x:Name="ModeSelector" HorizontalAlignment="Stretch" SelectionChanged="OnModeSelectionChanged">
                <toolkit:SegmentedItem Tag="NoiseCanceling" Content="NC" ToolTipService.ToolTip="ノイズキャンセリング">
                    <toolkit:SegmentedItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/Official/Icons/Dark/ic_noise_cancellation_regular_96px.png" ShowAsMonochrome="True" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
                <toolkit:SegmentedItem Tag="Transparent" Content="トランスペアレント" ToolTipService.ToolTip="外音取り込み（トランスペアレント）">
                    <toolkit:SegmentedItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/Official/Icons/Dark/ic_ambiet_sound_regular_96px.png" ShowAsMonochrome="True" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
                <toolkit:SegmentedItem Tag="Attention" Content="アテンション" ToolTipService.ToolTip="外音取り込み（アテンション）">
                    <toolkit:SegmentedItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/Official/Icons/Dark/ic_ambiet_sound_regular_96px.png" ShowAsMonochrome="True" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
                <toolkit:SegmentedItem Tag="Off" Content="OFF" ToolTipService.ToolTip="OFF">
                    <toolkit:SegmentedItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/Official/Icons/Dark/ic_normal_regular_96px.png" ShowAsMonochrome="True" />
                    </toolkit:SegmentedItem.Icon>
                </toolkit:SegmentedItem>
            </toolkit:Segmented>

            <TextBlock x:Name="ModeTitle" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />

            <!-- ダイヤルは決まった大きさで描き、狭いときだけ縮める -->
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center">
                <controls:CircularDial x:Name="Dial" ValueChanging="OnDialChanging" ValueCommitted="OnDialCommitted" />
            </Viewbox>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <ProgressRing x:Name="ApplyingRing" Width="16" Height="16" IsActive="False" />
                <FontIcon x:Name="SyncIcon" FontSize="16" />
                <TextBlock x:Name="SyncText" Style="{ThemeResource BodyTextBlockStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
