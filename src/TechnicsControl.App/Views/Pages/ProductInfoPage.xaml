<Page
    x:Class="TechnicsControl.App.Views.Pages.ProductInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="860" Padding="36,8,36,36" Spacing="4">
            <Grid Margin="0,0,0,8">
                <TextBlock Text="製品情報" Style="{ThemeResource TitleTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Click="OnRefreshClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="更新" />
                    </StackPanel>
                </Button>
            </Grid>
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" />

            <toolkit:SettingsCard Header="機種">
                <TextBlock x:Name="ModelText" IsTextSelectionEnabled="True" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="ファームウェアのバージョン">
                <TextBlock x:Name="FirmwareText" IsTextSelectionEnabled="True" TextAlignment="Right" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="使用時間" Description="ヘッドホンの電源が入っていた合計時間">
                <TextBlock x:Name="UsageText" TextAlignment="Right" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="充電エラー" Description="充電端子の汚れなどで充電できなかった回数（連続／累計）">
                <TextBlock x:Name="ChargeErrorText" TextAlignment="Right" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
