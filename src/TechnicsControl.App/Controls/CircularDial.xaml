<UserControl
    x:Class="TechnicsControl.App.Controls.CircularDial"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    AutomationProperties.Name="強さ">
    <Grid x:Name="Root" Width="260" Height="240" Background="Transparent">
        <Path x:Name="TrackPath" Stroke="{ThemeResource ControlStrongFillColorDisabledBrush}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Path x:Name="ValuePath" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Canvas>
            <Ellipse x:Name="Knob" Width="28" Height="28"
                     Fill="{ThemeResource ControlSolidFillColorDefaultBrush}"
                     Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="3" />
        </Canvas>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="ValueText" HorizontalAlignment="Center" FontSize="52" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="100" />
            <TextBlock x:Name="CaptionText" HorizontalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBlock Text="Min" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="38,0,0,6" />
        <TextBlock Text="Max" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,36,6" />
    </Grid>
</UserControl>
